{
  "name": "deskgroups",
  "version": "1.0.0",
  "description": "Personal desktop organizer: groups of apps, folders and websites on your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.deskgroups",
    "productName": "DeskGroups",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ]
  }
}